{
  "expo": {
    "name": "Viibe",
    "slug": "viibe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viibe",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viibe.app",
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_API_KEY_IOS"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "See nearby venues and verify you're at a location to submit vibe checks",
        "NSLocationAlwaysUsageDescription": "Get updates about nearby venues",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.viibe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_ANDROID"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VIIBE notices when you walk into a venue on the map, so it can count the room and ask you how it feels. It only records arriving at and leaving listed venues, never where you go in between. You can switch this off in your profile.",
          "locationWhenInUsePermission": "VIIBE uses your location to confirm you are inside a venue when you share a reading.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CityEnergy",
              "label": "VIIBE City Energy",
              "description": "Live Lagos energy on your home screen",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "VIIBE reads how loud a room is and how fast the music beats. No audio is recorded or stored."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "842b6059-0690-47f5-8c65-51467918769c"
      }
    },
    "owner": "oluyori09"
  }
}
